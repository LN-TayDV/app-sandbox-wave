#!/usr/bin/env python3
"""validate_theory_layer.py - validator 7 checks."""
import argparse, csv, json, re, sys
from pathlib import Path

ROOT = Path(r"C:\Users\PC\Documents\AI_project\sandbox-financial")
BOOKS_YAML = ROOT / "theory" / "registry" / "books.yaml"
LOG = ROOT / "logs" / "registry_validation.json"

LABELS = {"BOOK_EVIDENCE","PRIMARY_SOURCE","SECONDARY_SOURCE","DERIVED_RESULT",
          "RESEARCH_HYPOTHESIS","RESEARCH_SYNTHESIS","UNVERIFIED","SOURCE_GAP",
          "FORMULA_UNVERIFIED","NUMERICALLY_VERIFIED","VERIFIED","ILLUSTRATIVE"}
KINDS = {"concept","equation","assumption","theorem","caveat","example","figure","table","exercise","narrative"}

def load_books():
    # minimal yaml parse for total_pages
    import re
    txt = BOOKS_YAML.read_text(encoding="utf-8")
    res = {}
    cur = None
    for line in txt.splitlines():
        m = re.match(r"^\s{2}(\w+):\s*$", line)
        if m:
            cur = m.group(1); res[cur] = {}
            continue
        m = re.match(r"^\s{4}total_pages:\s*(\d+)", line)
        if m and cur:
            res[cur]["total_pages"] = int(m.group(1))
    return res

def try_latex(s):
    if not s or not s.strip():
        return True, ""
    try:
        import sympy
        from sympy.parsing.latex import parse_latex
        parse_latex(s)
        return True, ""
    except Exception as e:
        # minimal fallback: balanced braces
        if s.count("{") != s.count("}"):
            return False, "unbalanced braces"
        return True, ""

def validate(path):
    errors = []
    books = load_books()
    p = Path(path)
    if not p.exists():
        return {"file": str(path), "errors": [{"line": 0, "msg": "file not found"}]}
    text = p.read_text(encoding="utf-8", errors="replace").strip()
    if text == "":
        return {"file": str(path), "errors": [], "note": "empty file, no rows"}
    with open(p, newline="", encoding="utf-8") as f:
        reader = csv.reader(f)
        rows = list(reader)
    if not rows:
        return {"file": str(path), "errors": []}
    header = rows[0]
    data = rows[1:]
    # schema check
    if len(header) not in (16, 19):
        errors.append({"line": 1, "msg": f"unexpected column count {len(header)} (expected 16 or 19)"})
    idx = {name: i for i, name in enumerate(header)}
    seen_ids = set()
    for ri, row in enumerate(data, start=2):
        if not row:
            continue
        # pad
        while len(row) < len(header):
            row.append("")
        def get(col):
            i = idx.get(col)
            if i is None or i >= len(row):
                return ""
            return row[i].strip()
        gid = get("global_id")
        book = get("book_code")
        pp = get("printed_page")
        pdfp = get("pdf_page")
        vs = get("verification_status")
        kind = get("kind")
        latex = get("equation_latex")
        theory_id = get("theory_id")
        note = get("note")
        # global_id format & uniqueness
        if gid:
            if not re.match(r"^(CONCEPT|EQUATION|ASSUMPTION|THEOREM|CAVEAT|EXAMPLE|FIGURE|TABLE|EXERCISE|NARRATIVE)-[A-Z]{3}-\d{4}$", gid):
                errors.append({"line": ri, "msg": f"bad global_id format: {gid}"})
            if gid in seen_ids:
                errors.append({"line": ri, "msg": f"duplicate global_id: {gid}"})
            seen_ids.add(gid)
        # book_code
        if book and book not in ("HAN","ROM","PIN","MAD"):
            errors.append({"line": ri, "msg": f"invalid book_code: {book}"})
        # pages
        if (pp == "") != (pdfp == ""):
            errors.append({"line": ri, "msg": "printed_page/pdf_page must both present or both empty"})
        if pdfp:
            try:
                n = int(pdfp)
                tp = books.get(book, {}).get("total_pages")
                if tp is not None and n > tp:
                    errors.append({"line": ri, "msg": f"pdf_page {n} > total_pages {tp}"})
            except ValueError:
                errors.append({"line": ri, "msg": f"non-integer pdf_page: {pdfp}"})
        # vocab
        if vs and vs not in LABELS:
            errors.append({"line": ri, "msg": f"unknown verification_status: {vs}"})
        if kind and kind not in KINDS:
            errors.append({"line": ri, "msg": f"unknown kind: {kind}"})
        # latex
        ok, msg = try_latex(latex)
        if not ok:
            errors.append({"line": ri, "msg": f"latex parse error: {msg}"})
        # status completeness
        if vs == "FORMULA_UNVERIFIED" and not note:
            errors.append({"line": ri, "msg": "FORMULA_UNVERIFIED requires note"})
        if vs in ("VERIFIED","NUMERICALLY_VERIFIED") and pp == "":
            errors.append({"line": ri, "msg": f"{vs} requires printed_page"})
        # FK theory_id checked later globally? check existence in same file set of theory ids
    # FK theory_id: collect theory ids in this file if has global_id column and kind theory? We'll check against all global_ids in theory registry files passed? For single file, check within same file if theory_id column exists.
    if "theory_id" in idx:
        ids = set()
        for row in data:
            while len(row) < len(header): row.append("")
            g = row[idx["global_id"]].strip() if idx.get("global_id") is not None and idx["global_id"] < len(row) else ""
            if g: ids.add(g)
        for ri, row in enumerate(data, start=2):
            while len(row) < len(header): row.append("")
            tid = row[idx["theory_id"]].strip() if idx.get("theory_id") is not None and idx["theory_id"] < len(row) else ""
            if tid and tid not in ids:
                errors.append({"line": ri, "msg": f"theory_id not found: {tid}"})
    return {"file": str(path), "errors": errors}

def main():
    global BOOKS_YAML
    ap = argparse.ArgumentParser(description="Validate theory layer registries.")
    ap.add_argument("--registry", required=True, help="path to csv registry")
    ap.add_argument("--books", default=str(BOOKS_YAML))
    ap.add_argument("--out", default=str(LOG))
    args = ap.parse_args()
    BOOKS_YAML = Path(args.books)
    res = validate(args.registry)
    # write log (append? single file) - write this run
    Path(args.out).parent.mkdir(parents=True, exist_ok=True)
    Path(args.out).write_text(json.dumps(res, indent=2, ensure_ascii=False), encoding="utf-8")
    print(json.dumps(res, indent=2, ensure_ascii=False))
    sys.exit(1 if res["errors"] else 0)

if __name__ == "__main__":
    main()
